{
  "name": "dsh-dragon-raja",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Dragon Raja themed executive-login skin for DeepSeek Harness: clearance boot animation, operator welcome, and a Cassell College HUD.",
  "license": "MIT",
  "author": "sensencjq",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sensencjq/dsh-dragon-raja.git"
  },
  "homepage": "https://github.com/sensencjq/dsh-dragon-raja#readme",
  "bugs": "https://github.com/sensencjq/dsh-dragon-raja/issues",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "dragon-raja"
  ],
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
